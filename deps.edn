{:paths ["src"
         "resources"]
 :deps {org.clojure/clojure                 {:mvn/version "1.12.5"}
        metosin/malli                       {:mvn/version "0.20.1"}
        io.pedestal/pedestal.service        {:mvn/version "0.8.2"}
        io.pedestal/pedestal.http-kit       {:mvn/version "0.8.2"}
        io.github.tonsky/clj-reload         {:mvn/version "1.0.0"}
        ch.qos.logback/logback-classic      {:mvn/version "1.5.34"}
        cheshire/cheshire                   {:mvn/version "6.2.0"}
        camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
        aero/aero                           {:mvn/version "1.1.6"}
        clj-http/clj-http                   {:mvn/version "3.13.1"}
        com.github.seancorfield/next.jdbc   {:mvn/version "1.3.1118"}
        org.postgresql/postgresql           {:mvn/version "42.7.12"}
        hikari-cp/hikari-cp                 {:mvn/version "4.1.0"}}
 :aliases
 {:test
  {:extra-paths ["test"
                 "test-resources"]
   :extra-deps {org.clojure/test.check     {:mvn/version "1.1.3"}
                nubank/matcher-combinators {:mvn/version "3.10.0"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1"
                 :git/sha "dfb30dd"}}}

  :dev
  {:extra-paths ["dev"]
   :jvm-opts ["-Dio.pedestal.dev-mode=true"]}

  :run
  {:exec-fn  tetris-server.main/start-server}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.13"}
                 slipset/deps-deploy           {:mvn/version "0.2.2"}
                 org.clj-commons/pretty        {:mvn/version "3.8.0"}
                 clj-kondo/clj-kondo           {:mvn/version "2026.05.25"}
                 io.github.tonsky/clj-reload   {:mvn/version "1.0.0"}}
          :ns-default build}}}
